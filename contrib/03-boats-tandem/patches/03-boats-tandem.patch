+  }
+  // 系船桩（停在岸边时）
+  if (o.moored) { img.rect(4, 5 + lift, 1, 6, HULL_D); img.set(4, 4 + lift, DECK); }
+  return img;
+}
+
+/**
+ * 正/背视（俯视多一点）：一圈浅色船沿包着深色船舱，中间横一块坐板；船头那一端收窄。
