+  img.rect(7, 7, 1, 1, hex('#c4503c'));
+  for (let a = 0; a < 12; a++) {                     // 刻度
+    const ang = (a / 12) * Math.PI * 2, x = 7.5 + Math.cos(ang) * 4.2, y = 7.5 + Math.sin(ang) * 4.2;
