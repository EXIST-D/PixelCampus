+/** 挂钟（墙面挂件）：木框 + 表盘 + 指针 */
+export function wallclock(): Furn {
+  const img = new Img(16, 16);
+  img.ellipse(7.5, 7.5, 7, 7, W[2]);
+  img.ellipse(7.5, 7.5, 6, 6, CREAM[2]);
