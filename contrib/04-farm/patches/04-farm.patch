diff --git a/src/ui/FarmBar.ts b/src/ui/FarmBar.ts
new file mode 100644
index 0000000..ba39eec
--- /dev/null
+++ b/src/ui/FarmBar.ts
@@ -0,0 +1,119 @@
+/**
+ * 实验田的底部操作条：显示 12 格的状态，点格子后在这里选操作。
+ * 只管界面；能不能种、浇、收全由服务器判（客户端只负责发消息和显示）。
+ */
+import { CROPS, cropDef, isRipe, type Plots } from '@/shared/farm';
+
+const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
+  const e = document.createElement(tag);
+  if (cls) e.className = cls;
+  if (text !== undefined) e.textContent = text;
+  return e;
+};
+
+export interface FarmHooks {
+  plant(i: number, k: string): void;
+  water(i: number): void;
+  harvest(i: number): void;
+  waterAll(): void;
+  close(): void;
+}
+
+export class FarmBar {
+  private root = el('div', 'farm-bar hidden');
+  private tip = el('div', 'farm-tip', '');
+  private act = el('div', 'farm-act');          // 当前选中格的操作
+  private pick = el('div', 'farm-pick hidden'); // 选种子
+  private plot: Plots = [];
+  private day = 0;
+  private sel = -1;
+
+  constructor(private hooks: FarmHooks) {
+    this.root.style.pointerEvents = 'auto';     // #hud 是 pointer-events:none，浮层要自己打开
+    const head = el('div', 'farm-head');
+    head.append(el('span', 'farm-title', '🌱 我的实验田'), this.tip);
+    const allBtn = el('button', 'btn', '💧 一键浇水');
+    allBtn.type = 'button';
+    allBtn.addEventListener('click', () => this.hooks.waterAll());
+    const closeBtn = el('button', 'btn', '🚪 出去');
+    closeBtn.type = 'button';
+    closeBtn.addEventListener('click', () => this.hooks.close());
+    head.append(allBtn, closeBtn);
+    const body = el('div', 'farm-body');
+    body.append(this.act, this.pick);
+    this.root.append(head, body);
+  }
+
+  get isOpen() { return !this.root.classList.contains('hidden'); }
+
+  open() {
+    document.querySelectorAll('.farm-bar').forEach((n) => n.remove());
+    (document.getElementById('hud') ?? document.body).append(this.root);
+    this.root.classList.remove('hidden');
+  }
+  close() { this.root.classList.add('hidden'); this.sel = -1; }
+
+  /** 服务器推来的新状态 */
+  set(plots: Plots, day: number) {
+    this.plot = plots; this.day = day;
+    const ripe = plots.filter((p) => p && cropDef(p.k) && isRipe(cropDef(p.k)!, p)).length;
+    const thirsty = plots.filter((p) => p && cropDef(p.k) && !isRipe(cropDef(p.k)!, p) && p.wd !== day).length;
+    const empty = plots.filter((p) => !p).length;
+    this.tip.textContent = `能收 ${ripe} 格 · 该浇 ${thirsty} 格 · 空地 ${empty} 格`;
+    if (this.sel >= 0) this.renderSel();
+  }
+
+  /** 玩家点了第 i 格 */
+  select(i: number) {
+    if (i < 0 || i >= this.plot.length) return;
+    this.sel = i;
+    this.renderSel();
+  }
+
+  say(msg: string, ok = true) {
+    this.tip.textContent = msg;
+    this.tip.classList.toggle('bad', !ok);
+    if (!ok) return;
+    // 成功提示 4 秒后回到状态行
+    window.setTimeout(() => { if (this.isOpen && this.sel >= 0) this.renderSel(); }, 4000);
+  }
+
+  private renderSel() {
+    this.act.replaceChildren();
+    this.pick.replaceChildren();
+    this.pick.classList.add('hidden');
+    if (this.sel < 0) { this.act.append(el('div', 'farm-hint', '点一下地里的格子：空地选种子，种了东西就浇水，熟了就能收')); return; }
+    const cell = this.plot[this.sel];
+    const no = el('span', 'farm-no', `第 ${this.sel + 1} 格`);
+    if (!cell) {
+      this.act.append(no, el('span', 'farm-hint', '空地 · 种点什么？'));
+      this.pick.classList.remove('hidden');
+      for (const c of CROPS) {
+        const b = el('button', 'btn farm-seed', `${c.name} · ${c.seed} 币 / ${c.days} 天`);
+        b.type = 'button';
+        b.title = c.note;
+        b.addEventListener('click', () => this.hooks.plant(this.sel, c.k));
+        this.pick.append(b);
+      }
+      return;
+    }
+    const c = cropDef(cell.k);
+    if (!c) { this.act.append(no, el('span', 'farm-hint', '这格里的作物不认识')); return; }
+    if (isRipe(c, cell)) {
+      const b = el('button', 'btn primary', `🧺 收${c.name}`);
+      b.type = 'button';
+      b.addEventListener('click', () => this.hooks.harvest(this.sel));
+      this.act.append(no, el('span', 'farm-hint', `${c.name}熟了（每个卖 ${c.price}）`), b);
+      return;
+    }
+    const left = c.days - cell.g;
+    if (cell.wd === this.day) {
+      this.act.append(no, el('span', 'farm-hint', `${c.name} · 今天浇过了，还要浇 ${left} 次`));
+      return;
+    }
+    const b = el('button', 'btn primary', '💧 浇水');
+    b.type = 'button';
+    b.addEventListener('click', () => this.hooks.water(this.sel));
+    this.act.append(no, el('span', 'farm-hint', `${c.name} · 还要浇 ${left} 次`), b);
+  }
+}
diff --git a/tests/farm.test.ts b/tests/farm.test.ts
new file mode 100644
index 0000000..cab31d4
--- /dev/null
+++ b/tests/farm.test.ts
@@ -0,0 +1,78 @@
+import { describe, it, expect } from 'vitest';
+import { CROPS, FARM_PLOTS, cleanFarmSave, cleanPlots, cropDef, farmSummary, harvest, isRipe, stageOf, type Plot } from '../src/shared/farm';
+
+const mk = (k: string, g: number, wd = 0): Plot => ({ k, g, wd });
+
+describe('实验田规则', () => {
+  it('三种作物的价格和天数都在合理区间（避免手滑写成 0 或负）', () => {
+    expect(CROPS.length).toBe(3);
+    for (const c of CROPS) {
+      expect(c.seed).toBeGreaterThan(0);
+      expect(c.days).toBeGreaterThanOrEqual(2);
+      expect(c.days).toBeLessThanOrEqual(5);
+      expect(c.price).toBeGreaterThan(0);
+      expect(c.yield[0]).toBeGreaterThanOrEqual(1);
+      expect(c.yield[1]).toBeGreaterThanOrEqual(c.yield[0]);
+    }
+  });
+
+  it('卖掉收成要能回本（不然没人种）', () => {
+    for (const c of CROPS) {
+      const worst = c.yield[0] * c.price;      // 最差情况：只收最少的那几个
+      expect(worst, `${c.name} 最差收成 ${worst} 要 ≥ 种子 ${c.seed}`).toBeGreaterThan(c.seed * 0.8);
+    }
+  });
+
+  it('生长阶段：0 次水是种子，浇满就成熟', () => {
+    const c = cropDef('potato')!;                // 3 次水
+    expect(stageOf(c, 0)).toBe(0);
+    expect(stageOf(c, 1)).toBe(1);
+    expect(stageOf(c, 2)).toBe(2);
+    expect(stageOf(c, 3)).toBe(3);
+    expect(stageOf(c, 99)).toBe(3);              // 超了也停在成熟，不会溢出到别的帧
+  });
+
+  it('成熟判定和"还要浇几次"对得上', () => {
+    const c = cropDef('cabbage')!;               // 2 次水
+    expect(isRipe(c, mk('cabbage', 1))).toBe(false);
+    expect(isRipe(c, mk('cabbage', 2))).toBe(true);
+  });
+
+  it('收获数量落在 yield 区间、卖价 = 数量 × 单价', () => {
+    const c = cropDef('pumpkin')!;
+    for (const r of [0, 0.25, 0.5, 0.75, 0.99]) {
+      const got = harvest(c, () => r);
+      expect(got.n).toBeGreaterThanOrEqual(c.yield[0]);
+      expect(got.n).toBeLessThanOrEqual(c.yield[1]);
+      expect(got.coins).toBe(got.n * c.price);
+    }
+  });
+
+  it('存档清洗：固定 12 格、坏数据当空格、进度不会超过成熟天数', () => {
+    const p = cleanPlots([{ k: 'potato', g: 99, wd: 3 }, null, { k: '不存在', g: 1 }, { k: 'cabbage', g: -5, wd: 1 }]);
+    expect(p.length).toBe(FARM_PLOTS);
+    expect(p[0]).toEqual({ k: 'potato', g: 3, wd: 3 });   // 99 被压到成熟天数
+    expect(p[1]).toBeNull();
+    expect(p[2]).toBeNull();                               // 不认识的作物 → 空
+    expect(p[3]).toEqual({ k: 'cabbage', g: 0, wd: 1 });
+    expect(cleanPlots('乱来').every((x) => x === null)).toBe(true);
+  });
+
+  it('整块地全空时不写存档（省得 players.json 里一堆 null）', () => {
+    expect(cleanFarmSave({ p: [null, null] })).toBeUndefined();
+    expect(cleanFarmSave({ p: [null, { k: 'potato', g: 1, wd: 2 }] })?.p?.[1]).toEqual({ k: 'potato', g: 1, wd: 2 });
+  });
+
+  it('汇总：能收 / 该浇 / 空地分开算（今天浇过的不算"该浇"）', () => {
+    const day = 100;
+    const s = farmSummary([
+      mk('potato', 3, day),        // 熟了
+      mk('potato', 1, day),        // 今天浇过 → 不用浇
+      mk('potato', 1, day - 1),    // 昨天浇的 → 该浇
+      null,
+    ], day);
+    expect(s).toEqual({ ripe: 1, thirsty: 1, empty: 1 });   // 这里只传了 4 格，空的就是那 1 个
+    // 真实调用传的是 cleanPlots 的 12 格，空格数才对得上
+    expect(farmSummary(cleanPlots([{ k: 'potato', g: 1, wd: day }]), day)).toEqual({ ripe: 0, thirsty: 0, empty: FARM_PLOTS - 1 });
+  });
+});
